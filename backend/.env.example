# ---- Gemini AI ----
# Required. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional fallback key, used automatically if the primary key hits quota / rate limits.
GEMINI_API_KEY_SECONDARY=""
# Optional comma-separated model fallback order (defaults are built in).
# GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.5-flash"

# ---- MongoDB (primary storage) ----
# Atlas connection string. Without it, records are kept only in the local JSON cache.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Database name (the `employees` collection is created inside it by scripts/setup_db.py)
MONGODB_DB="kf_bio_plant"

# ---- Server ----
# Comma-separated browser origins allowed to call the API directly (the Vite dev proxy doesn't need this).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Folder for the local JSON cache of employee records (default: backend/data)
# DATA_DIR=""
